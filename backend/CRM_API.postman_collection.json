{
  "info": {
    "name": "CRM Platform API",
    "description": "Complete API collection for Quantic Marketing Funnel CRM",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "process_type_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "deal_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (joe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"joe\",\"password\":\"password123\"}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"newuser\",\"email\":\"newuser@example.com\",\"password\":\"securepass\",\"full_name\":\"New User\"}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"full_name\":\"Updated Name\"}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Process Types",
      "item": [
        {
          "name": "Get All Process Types",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/process-types",
              "host": ["{{base_url}}"],
              "path": ["process-types"]
            }
          }
        },
        {
          "name": "Get Process Type by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/process-types/{{process_type_id}}",
              "host": ["{{base_url}}"],
              "path": ["process-types", "{{process_type_id}}"]
            }
          }
        },
        {
          "name": "Create Process Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Custom Process\",\"description\":\"A custom sales process\"}"
            },
            "url": {
              "raw": "{{base_url}}/process-types",
              "host": ["{{base_url}}"],
              "path": ["process-types"]
            }
          }
        },
        {
          "name": "Update Process Type",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Updated description\"}"
            },
            "url": {
              "raw": "{{base_url}}/process-types/{{process_type_id}}",
              "host": ["{{base_url}}"],
              "path": ["process-types", "{{process_type_id}}"]
            }
          }
        },
        {
          "name": "Delete Process Type",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/process-types/{{process_type_id}}",
              "host": ["{{base_url}}"],
              "path": ["process-types", "{{process_type_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Deals",
      "item": [
        {
          "name": "Get All Deals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/deals",
              "host": ["{{base_url}}"],
              "path": ["deals"]
            }
          }
        },
        {
          "name": "Get Deals by Stage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/deals?stage=interested",
              "host": ["{{base_url}}"],
              "path": ["deals"],
              "query": [
                {
                  "key": "stage",
                  "value": "interested"
                }
              ]
            }
          }
        },
        {
          "name": "Get Deals by Country",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/deals?country=Gujarat",
              "host": ["{{base_url}}"],
              "path": ["deals"],
              "query": [
                {
                  "key": "country",
                  "value": "Gujarat"
                }
              ]
            }
          }
        },
        {
          "name": "Get Deal by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/deals/{{deal_id}}",
              "host": ["{{base_url}}"],
              "path": ["deals", "{{deal_id}}"]
            }
          }
        },
        {
          "name": "Create Deal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"company_name\":\"Acme Corp\",\"location\":\"Delhi, India\",\"deal_value\":5000000,\"process_type_id\":\"{{process_type_id}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/deals",
              "host": ["{{base_url}}"],
              "path": ["deals"]
            }
          }
        },
        {
          "name": "Update Deal",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"deal_value\":7500000}"
            },
            "url": {
              "raw": "{{base_url}}/deals/{{deal_id}}",
              "host": ["{{base_url}}"],
              "path": ["deals", "{{deal_id}}"]
            }
          }
        },
        {
          "name": "Update Deal Stage",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stage\":\"proposal_sent\"}"
            },
            "url": {
              "raw": "{{base_url}}/deals/{{deal_id}}/stage",
              "host": ["{{base_url}}"],
              "path": ["deals", "{{deal_id}}", "stage"]
            }
          }
        },
        {
          "name": "Delete Deal",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/deals/{{deal_id}}",
              "host": ["{{base_url}}"],
              "path": ["deals", "{{deal_id}}"]
            }
          }
        }
      ]
    }
  ]
}
